# Copy to .env and adjust. Never commit the real .env.
POSTGRES_DB=bi
POSTGRES_USER=bi
POSTGRES_PASSWORD=change-me
WEB_PORT=8080
APP_ENV=production
MAX_UPLOAD_MB=100
WEB_CONCURRENCY=2
# Only needed if the browser calls the API from a different origin than nginx serves.
CORS_ORIGINS=http://localhost:8080

# Optional: AI-written interpretations for insights (observations stay statistical).
# Leave empty for rule-based interpretations.
ANTHROPIC_API_KEY=
INSIGHTS_LLM_MODEL=claude-sonnet-5-5
