{
  "name": "Meridian Navy",
  "dataColors": [
    "#2A78D6",
    "#EB6834",
    "#1BAF7A",
    "#EDA100",
    "#E87BA4",
    "#008300",
    "#6250D6",
    "#E34948"
  ],
  "foreground": "#1E2532",
  "foregroundNeutralSecondary": "#4E5B70",
  "foregroundNeutralTertiary": "#6F7C92",
  "background": "#FFFFFF",
  "backgroundLight": "#F7F9FB",
  "backgroundNeutral": "#E2E7EE",
  "tableAccent": "#0B1F3A",
  "good": "#0B7A3B",
  "neutral": "#EDA100",
  "bad": "#B9312A",
  "maximum": "#0D366B",
  "center": "#6DA7EC",
  "minimum": "#CDE2FB",
  "null": "#F1F3F6",
  "hyperlink": "#1C5CAB",
  "visitedHyperlink": "#1C5CAB",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B1F3A"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1E2532"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1E2532"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#4E5B70"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E7EE"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": true
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F8"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F8"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E2E7EE"
              }
            },
            "gridVertical": false
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0B1F3A"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0B1F3A"
              }
            }
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1E2532"
              }
            }
          }
        ]
      }
    }
  }
}
