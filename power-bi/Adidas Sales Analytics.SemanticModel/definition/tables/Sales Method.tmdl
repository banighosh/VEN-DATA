table 'Sales Method'
	lineageTag: 3073d1c7-a132-53ce-a248-502ac82211a8

	column 'Sales Method'
		dataType: string
		lineageTag: 593c9a26-c9e7-5547-a0a6-8256e8b8f41b
		summarizeBy: none
		sourceColumn: Sales Method
		sortByColumn: 'Sales Method Order'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Sales Method Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 8402b71e-b952-5bae-b1c8-04dd7972cbb0
		summarizeBy: none
		sourceColumn: Sales Method Order

		annotation SummarizationSetBy = Automatic

	partition 'Sales Method' = m
		mode: import
		source =
				let
				    Source = Sales,
				    Columns = Table.SelectColumns(Source, {"Sales Method"}),
				    Distinct = Table.Distinct(Columns),
				    WithOrder = Table.AddColumn(Distinct, "Sales Method Order", each if [Sales Method] = "In-Store" then 1 else if [Sales Method] = "Outlet" then 2 else 3, Int64.Type)
				in
				    WithOrder

	annotation PBI_ResultType = Table
