	measure 'Revenue PY' = IF ( COUNTROWS ( VALUES ( 'Calendar'[Year] ) ) = 1, CALCULATE ( [Total Revenue], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) ) )
