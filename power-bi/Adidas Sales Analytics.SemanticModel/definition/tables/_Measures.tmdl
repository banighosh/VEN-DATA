	measure 'Revenue vs PY' = ```
			VAR PrevValue = [Revenue PY]
			VAR Delta = DIVIDE ( [Total Revenue] - [Revenue PY], [Revenue PY] )
			RETURN
			    IF (
			        NOT ( COUNTROWS ( VALUES ( 'Calendar'[Year] ) ) = 1 ),
			        "Select one year to compare",
			        IF (
			            ISBLANK ( PrevValue ),
			            "No prior-year data",
			            IF ( Delta >= 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) & " " & FORMAT ( Delta, "+0.0%;-0.0%;0.0%" ) & " vs prior year (" & FORMAT ( PrevValue / 1000000, "$#,0.0" ) & "M" & ")"
			        )
			    )
			```
		displayFolder: 3. KPI labels
		lineageTag: 842f243c-f62e-5cf4-a01e-7ba5c128af5d

	measure 'Units vs PY' = ```
			VAR PrevValue = [Units PY]
