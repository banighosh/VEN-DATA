		lineageTag: cb32ae1f-33bf-5e2e-885d-ca1c7b351b03

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Operating Margin' = DIVIDE ( [Operating Profit], [Total Revenue] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1. Core
		lineageTag: 455a38e6-505a-52b6-9551-643690a1e6a4

	measure 'Implied Cost' = [Total Revenue] - [Operating Profit]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1. Core
		lineageTag: cf9203e3-bb5d-57ec-a28d-1c684f32ae5d

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure Transactions = COUNTROWS ( Sales )
