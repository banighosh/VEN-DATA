table _Measures
	lineageTag: ac94060a-2a57-532b-93c7-aee1feaa2935

	measure 'Total Revenue' = SUM ( Sales[Total Sales] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1. Core
		lineageTag: bd687acb-f343-594c-ab39-7963f1f74b3c

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Units Sold' = SUM ( Sales[Units Sold] )
		formatString: #,0
		displayFolder: 1. Core
		lineageTag: 9c7866e7-c30e-54b1-9457-e7e656e430f6

	measure 'Operating Profit' = SUM ( Sales[Operating Profit] )
