	measure 'First Purchase' = CALCULATE ( MIN ( Sales[Invoice Date] ), REMOVEFILTERS ( 'Calendar' ) )
		formatString: dd mmm yyyy
		displayFolder: 4. Retailers
		lineageTag: e082e68f-6c56-56b3-aca9-4e55be93a52d

	measure 'Last Purchase' = CALCULATE ( MAX ( Sales[Invoice Date] ), REMOVEFILTERS ( 'Calendar' ) )
		formatString: dd mmm yyyy
		displayFolder: 4. Retailers
		lineageTag: 57fcb54e-2343-5096-9b01-ec72e4b15a55

